import { test, expect, Page } from '@playwright/test';
import { LoginPage } from '../../interface/ui/loginPage';
import { DashboardPage } from '../../interface/ui/dashboardPage';
import { ConversationPage } from '../../interface/ui/conversationPage';
import { ChatWidgetPage } from '../../interface/ui/chatWidgetPage';
import * as allure from 'allure-js-commons';

/**
 * Test Suite: Real-Time Message Delivery and Synchronization
 * Business Value: CRITICAL - Ensures instant communication
 * Tests message delivery speed, real-time updates, and synchronization
 */
test.describe('Chat Communication - Real-Time Delivery', { tag: ['@chat', '@high-priority', '@performance', '@realtime'] }, () => {
    let operatorPage: Page;
    let visitorPage: Page;
    let loginPage: LoginPage;
    let dashboardPage: DashboardPage;
    let conversationPage: ConversationPage;
    let chatWidgetPage: ChatWidgetPage;

    test.beforeEach(async ({ browser }) => {
        // Create two separate browser contexts for operator and visitor
        const operatorContext = await browser.newContext();
        const visitorContext = await browser.newContext();

        operatorPage = await operatorContext.newPage();
        visitorPage = await visitorContext.newPage();

        // Initialize page objects
        loginPage = new LoginPage(operatorPage);
        dashboardPage = new DashboardPage(operatorPage);
        conversationPage = new ConversationPage(operatorPage);
        chatWidgetPage = new ChatWidgetPage(visitorPage);

        // Operator: Login to Smartsupp Dashboard
        await allure.step('Operator: Login to Dashboard', async () => {
            await loginPage.navigate();
            await loginPage.login(process.env.SMARTSUPP_USERNAME!, process.env.SMARTSUPP_PASSWORD!);
            await dashboardPage.verifyDashboardPageLoaded();
            await conversationPage.navigateToInbox();
            await conversationPage.verifyInboxLoaded();
        });

        // Visitor: Open chat widget
        await allure.step('Visitor: Open chat widget', async () => {
            await chatWidgetPage.navigateToPageWithChat(process.env.CHAT_WIDGET_URL || 'https://www.smartsupp.com');
            await chatWidgetPage.openChatWidget();
            await chatWidgetPage.verifyChatWidgetVisible();
        });

        // Setup active conversation
        await allure.step('Setup active conversation', async () => {
            await chatWidgetPage.sendMessage(`Init conversation - ${Date.now()}`);
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();
        });
    });

    test.afterEach(async () => {
        await operatorPage.close();
        await visitorPage.close();
    });

    test('Message delivery time - Visitor to Operator @PERFORMANCE @SMOKE', async () => {
        const testMessage = `Performance test V2O - ${Date.now()}`;
        let sendTime: number;
        let receiveTime: number;
        const maxDeliveryTime = 3000; // 3 seconds max

        await allure.step('Measure delivery time from visitor to operator', async () => {
            sendTime = Date.now();
            await chatWidgetPage.sendMessage(testMessage);

            // Wait for message to appear on operator side (no page reload)
            await conversationPage.verifyMessageReceived(testMessage, true);
            receiveTime = Date.now();

            const deliveryTime = receiveTime - sendTime;
            console.log(`Visitor → Operator delivery time: ${deliveryTime}ms`);

            await allure.attachment('Delivery Time', `${deliveryTime}ms`, 'text/plain');

            expect(deliveryTime).toBeLessThan(maxDeliveryTime);
        });
    });

    test('Message delivery time - Operator to Visitor @PERFORMANCE @SMOKE', async () => {
        const testMessage = `Performance test O2V - ${Date.now()}`;
        let sendTime: number;
        let receiveTime: number;
        const maxDeliveryTime = 3000; // 3 seconds max

        await allure.step('Measure delivery time from operator to visitor', async () => {
            sendTime = Date.now();
            await conversationPage.sendMessage(testMessage);

            // Wait for message to appear on visitor side
            await chatWidgetPage.verifyMessageReceived(testMessage);
            receiveTime = Date.now();

            const deliveryTime = receiveTime - sendTime;
            console.log(`Operator → Visitor delivery time: ${deliveryTime}ms`);

            await allure.attachment('Delivery Time', `${deliveryTime}ms`, 'text/plain');

            expect(deliveryTime).toBeLessThan(maxDeliveryTime);
        });
    });

    test('Simultaneous message sending from both sides', async () => {
        const visitorMessage = `Visitor simultaneous - ${Date.now()}`;
        const operatorMessage = `Operator simultaneous - ${Date.now()}`;

        await allure.step('Both parties send messages at the same time', async () => {
            // Send messages simultaneously
            await Promise.all([
                chatWidgetPage.sendMessage(visitorMessage),
                conversationPage.sendMessage(operatorMessage)
            ]);
        });

        await allure.step('Verify both messages delivered successfully', async () => {
            // Verify on operator side
            await conversationPage.verifyMessageReceived(visitorMessage, true);
            await conversationPage.verifyMessageSent(operatorMessage);

            // Verify on visitor side
            await chatWidgetPage.verifyMessageSent(visitorMessage);
            await chatWidgetPage.verifyMessageReceived(operatorMessage);
        });

        await allure.step('Verify correct message ordering', async () => {
            // Both messages should be present in conversation
            const operatorMessages = await conversationPage.getAllMessageTexts();
            expect(operatorMessages).toContain(expect.stringContaining(visitorMessage.substring(0, 20)));
            expect(operatorMessages).toContain(expect.stringContaining(operatorMessage.substring(0, 20)));

            const visitorMessages = await chatWidgetPage.getAllMessageTexts();
            expect(visitorMessages).toContain(expect.stringContaining(visitorMessage.substring(0, 20)));
            expect(visitorMessages).toContain(expect.stringContaining(operatorMessage.substring(0, 20)));
        });
    });

    test('Message synchronization across page refresh', async () => {
        const beforeRefreshMsg = `Before refresh - ${Date.now()}`;
        const afterRefreshMsg = `After refresh - ${Date.now()}`;

        await allure.step('Send message before refresh', async () => {
            await chatWidgetPage.sendMessage(beforeRefreshMsg);
            await conversationPage.verifyMessageReceived(beforeRefreshMsg, true);
        });

        await allure.step('Refresh operator page', async () => {
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();
        });

        await allure.step('Verify previous message persists', async () => {
            await conversationPage.verifyMessageReceived(beforeRefreshMsg, true);
        });

        await allure.step('Send new message after refresh', async () => {
            await chatWidgetPage.sendMessage(afterRefreshMsg);
            await conversationPage.verifyMessageReceived(afterRefreshMsg, true);
        });

        await allure.step('Verify both messages in correct order', async () => {
            await conversationPage.verifyMessageOrder([beforeRefreshMsg, afterRefreshMsg]);
        });
    });

    test('Real-time updates without page reload', async () => {
        const messages = [
            `Real-time msg 1 - ${Date.now()}`,
            `Real-time msg 2 - ${Date.now() + 1}`,
            `Real-time msg 3 - ${Date.now() + 2}`
        ];

        await allure.step('Visitor sends multiple messages without operator reload', async () => {
            for (const msg of messages) {
                await chatWidgetPage.sendMessage(msg);
                await visitorPage.waitForTimeout(1000);

                // Verify message appears in real-time on operator side (no reload)
                await conversationPage.verifyMessageReceived(msg, true);
            }
        });

        await allure.step('Operator responds with real-time updates on visitor side', async () => {
            const responses = [
                'Response 1',
                'Response 2',
                'Response 3'
            ];

            for (const response of responses) {
                await conversationPage.sendMessage(response);
                await operatorPage.waitForTimeout(1000);

                // Verify message appears in real-time on visitor side
                await chatWidgetPage.verifyMessageReceived(response);
            }
        });
    });

    test('Message delivery during high-frequency exchange @STRESS', async () => {
        const messageCount = 10;
        const messages: Array<{ sender: string; text: string; sendTime: number }> = [];

        await allure.step('Rapid message exchange', async () => {
            for (let i = 0; i < messageCount; i++) {
                const sender = i % 2 === 0 ? 'visitor' : 'operator';
                const text = `Rapid msg ${i + 1} from ${sender} - ${Date.now()}`;
                const sendTime = Date.now();

                messages.push({ sender, text, sendTime });

                if (sender === 'visitor') {
                    await chatWidgetPage.sendMessage(text);
                    // Verify on operator side immediately
                    await conversationPage.verifyMessageReceived(text, true);
                } else {
                    await conversationPage.sendMessage(text);
                    // Verify on visitor side immediately
                    await chatWidgetPage.verifyMessageReceived(text);
                }

                // Short delay between messages
                await operatorPage.waitForTimeout(300);
            }
        });

        await allure.step('Verify all messages delivered without loss', async () => {
            // Check operator side
            const operatorMessages = await conversationPage.getAllMessageTexts();
            for (const msg of messages) {
                const found = operatorMessages.some(m => m.includes(msg.text.substring(0, 15)));
                expect(found).toBeTruthy();
            }

            // Check visitor side
            const visitorMessages = await chatWidgetPage.getAllMessageTexts();
            for (const msg of messages) {
                const found = visitorMessages.some(m => m.includes(msg.text.substring(0, 15)));
                expect(found).toBeTruthy();
            }

            console.log(`Successfully delivered ${messageCount} messages in rapid succession`);
        });
    });

    test('Network latency simulation - Message queuing', async () => {
        const queuedMessage = `Queued message - ${Date.now()}`;

        await allure.step('Simulate offline state and send message', async () => {
            // Simulate offline
            await visitorPage.context().setOffline(true);

            // Try to send message while offline
            await chatWidgetPage.sendMessage(queuedMessage);

            // Wait a bit
            await visitorPage.waitForTimeout(2000);
        });

        await allure.step('Restore connection and verify message delivery', async () => {
            // Restore connection
            await visitorPage.context().setOffline(false);

            // Wait for reconnection
            await visitorPage.waitForTimeout(3000);

            // Verify message was queued and delivered
            await visitorPage.reload();
            await visitorPage.waitForLoadState('networkidle');
            await chatWidgetPage.openChatWidget();

            // Check if message appears after reconnection
            const visitorMessages = await chatWidgetPage.getAllMessageTexts();
            const messageFound = visitorMessages.some(m => m.includes(queuedMessage.substring(0, 15)));

            if (messageFound) {
                console.log('Message was successfully queued and delivered after reconnection');
            } else {
                console.log('Message queuing not supported or message was lost');
            }
        });
    });

    test('Conversation state consistency check', async () => {
        const testMessages = [
            { sender: 'visitor', text: `Consistency check V1 - ${Date.now()}` },
            { sender: 'operator', text: `Consistency check O1 - ${Date.now()}` },
            { sender: 'visitor', text: `Consistency check V2 - ${Date.now()}` },
            { sender: 'operator', text: `Consistency check O2 - ${Date.now()}` }
        ];

        await allure.step('Build conversation with alternating messages', async () => {
            for (const msg of testMessages) {
                if (msg.sender === 'visitor') {
                    await chatWidgetPage.sendMessage(msg.text);
                    await conversationPage.verifyMessageReceived(msg.text, true);
                } else {
                    await conversationPage.sendMessage(msg.text);
                    await chatWidgetPage.verifyMessageReceived(msg.text);
                }
                await operatorPage.waitForTimeout(500);
            }
        });

        await allure.step('Verify conversation state on both sides matches', async () => {
            // Get all messages from both sides
            const operatorMessages = await conversationPage.getAllMessageTexts();
            const visitorMessages = await chatWidgetPage.getAllMessageTexts();

            // Verify same number of messages
            console.log(`Operator sees ${operatorMessages.length} messages`);
            console.log(`Visitor sees ${visitorMessages.length} messages`);

            // Verify all expected messages are present on both sides
            for (const msg of testMessages) {
                const inOperator = operatorMessages.some(m => m.includes(msg.text.substring(0, 20)));
                const inVisitor = visitorMessages.some(m => m.includes(msg.text.substring(0, 20)));

                expect(inOperator).toBeTruthy();
                expect(inVisitor).toBeTruthy();
            }
        });
    });
});
