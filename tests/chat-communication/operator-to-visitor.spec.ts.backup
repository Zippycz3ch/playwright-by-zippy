import { test, expect, Page } from '@playwright/test';
import { LoginPage } from '../../interface/ui/loginPage';
import { DashboardPage } from '../../interface/ui/dashboardPage';
import { ConversationPage } from '../../interface/ui/conversationPage';
import { ChatWidgetPage } from '../../interface/ui/chatWidgetPage';
import * as allure from 'allure-js-commons';

/**
 * Test Suite: Operator to Visitor Message Communication
 * Business Value: HIGH - Core chat functionality
 * Tests operator response messages delivered to visitor
 */
test.describe('Chat Communication - Operator to Visitor', { tag: ['@chat', '@high-priority', '@business-critical'] }, () => {
    let operatorPage: Page;
    let visitorPage: Page;
    let loginPage: LoginPage;
    let dashboardPage: DashboardPage;
    let conversationPage: ConversationPage;
    let chatWidgetPage: ChatWidgetPage;

    test.beforeEach(async ({ browser }) => {
        // Create two separate browser contexts for operator and visitor
        const operatorContext = await browser.newContext();
        const visitorContext = await browser.newContext();

        operatorPage = await operatorContext.newPage();
        visitorPage = await visitorContext.newPage();

        // Initialize page objects
        loginPage = new LoginPage(operatorPage);
        dashboardPage = new DashboardPage(operatorPage);
        conversationPage = new ConversationPage(operatorPage);
        chatWidgetPage = new ChatWidgetPage(visitorPage);

        // Operator: Login to Smartsupp Dashboard
        await allure.step('Operator: Login to Dashboard', async () => {
            await loginPage.navigate();
            await loginPage.login(process.env.SMARTSUPP_USERNAME!, process.env.SMARTSUPP_PASSWORD!);
            await dashboardPage.verifyDashboardPageLoaded();
            await conversationPage.navigateToInbox();
            await conversationPage.verifyInboxLoaded();
        });

        // Visitor: Open chat widget and initiate conversation
        await allure.step('Visitor: Open chat widget', async () => {
            await chatWidgetPage.navigateToPageWithChat(process.env.CHAT_WIDGET_URL || 'https://www.smartsupp.com');
            await chatWidgetPage.openChatWidget();
            await chatWidgetPage.verifyChatWidgetVisible();
        });
    });

    test.afterEach(async () => {
        await operatorPage.close();
        await visitorPage.close();
    });

    test('Operator sends message and visitor receives it @SMOKE', async () => {
        const visitorMessage = `Visitor query - ${Date.now()}`;
        const operatorReply = `Operator response - ${Date.now()}`;

        await allure.step('Step 1: Visitor initiates conversation', async () => {
            await chatWidgetPage.sendMessage(visitorMessage);
            await chatWidgetPage.verifyMessageSent(visitorMessage);
        });

        await allure.step('Step 2: Operator opens conversation and sends reply', async () => {
            // Refresh and open the conversation
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();

            // Verify visitor's initial message
            await conversationPage.verifyMessageReceived(visitorMessage, true);

            // Send operator reply
            await conversationPage.sendMessage(operatorReply);
            await conversationPage.verifyMessageSent(operatorReply);
        });

        await allure.step('Step 3: Visitor receives operator message', async () => {
            // Verify message appears in visitor's chat
            await chatWidgetPage.verifyMessageReceived(operatorReply);

            // Verify operator name/identifier is shown (basic check)
            const operatorMsg = chatWidgetPage.getOperatorMessage(operatorReply);
            await expect(operatorMsg).toBeVisible();
        });
    });

    test('Operator sends multiple sequential messages to visitor', async () => {
        const visitorMessage = `Initial query - ${Date.now()}`;
        const operatorMessages = [
            `First response - ${Date.now()}`,
            `Second response - ${Date.now() + 1}`,
            `Third response - ${Date.now() + 2}`
        ];

        await allure.step('Step 1: Visitor starts conversation', async () => {
            await chatWidgetPage.sendMessage(visitorMessage);
            await chatWidgetPage.verifyMessageSent(visitorMessage);
        });

        await allure.step('Step 2: Operator sends multiple responses', async () => {
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();

            for (const msg of operatorMessages) {
                await conversationPage.sendMessage(msg);
                await operatorPage.waitForTimeout(500);
            }

            // Verify all messages sent
            for (const msg of operatorMessages) {
                await conversationPage.verifyMessageSent(msg);
            }
        });

        await allure.step('Step 3: Visitor receives all messages in order', async () => {
            // Verify all operator messages appear
            for (const msg of operatorMessages) {
                await chatWidgetPage.verifyMessageReceived(msg);
            }

            // Verify message order
            await chatWidgetPage.verifyMessageOrder(operatorMessages);
        });
    });

    test('Operator message delivery within acceptable time frame @PERFORMANCE', async () => {
        const visitorMessage = `Performance test query - ${Date.now()}`;
        const operatorReply = `Performance test response - ${Date.now()}`;
        let sendTime: number;
        let receiveTime: number;

        await allure.step('Step 1: Setup conversation', async () => {
            await chatWidgetPage.sendMessage(visitorMessage);
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();
        });

        await allure.step('Step 2: Operator sends message with timestamp', async () => {
            sendTime = Date.now();
            await conversationPage.sendMessage(operatorReply);
            await conversationPage.verifyMessageSent(operatorReply);
        });

        await allure.step('Step 3: Verify visitor receives message quickly', async () => {
            await chatWidgetPage.verifyMessageReceived(operatorReply);
            receiveTime = Date.now();

            const deliveryTime = receiveTime - sendTime;
            console.log(`Operator message delivery time: ${deliveryTime}ms`);

            // Verify delivery within 5 seconds (real-time expectation)
            expect(deliveryTime).toBeLessThan(5000);
        });
    });

    test('Operator sends message using Enter key', async () => {
        const visitorMessage = `Query via Enter - ${Date.now()}`;
        const operatorReply = `Reply via Enter key - ${Date.now()}`;

        await allure.step('Step 1: Setup conversation', async () => {
            await chatWidgetPage.sendMessage(visitorMessage);
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();
        });

        await allure.step('Step 2: Operator sends message using Enter key', async () => {
            await conversationPage.sendMessageWithEnter(operatorReply);
            await conversationPage.verifyMessageSent(operatorReply);
        });

        await allure.step('Step 3: Visitor receives message', async () => {
            await chatWidgetPage.verifyMessageReceived(operatorReply);
        });
    });

    test('Operator sends message with special characters and formatting', async () => {
        const visitorMessage = `Need help - ${Date.now()}`;
        const operatorReply = `Sure! 😊 Visit: https://example.com
Line 1
Line 2
Special: <>&"'`;

        await allure.step('Step 1: Setup conversation', async () => {
            await chatWidgetPage.sendMessage(visitorMessage);
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();
        });

        await allure.step('Step 2: Operator sends formatted message', async () => {
            await conversationPage.sendMessage(operatorReply);
            await conversationPage.verifyMessageSent(operatorReply);
        });

        await allure.step('Step 3: Visitor receives formatted message correctly', async () => {
            // Verify emojis are rendered
            const msgWithEmoji = chatWidgetPage.getOperatorMessage('😊');
            await expect(msgWithEmoji).toBeVisible();

            // Verify URL appears (basic check)
            await chatWidgetPage.verifyMessageReceived('https://example.com');

            // Verify multiline formatting preserved
            await chatWidgetPage.verifyMessageReceived('Line 1');
        });
    });

    test('Visitor sees operator message while chat is minimized then maximized', async () => {
        const visitorMessage = `Test minimized - ${Date.now()}`;
        const operatorReply = `Reply while minimized - ${Date.now()}`;

        await allure.step('Step 1: Start conversation and minimize chat', async () => {
            await chatWidgetPage.sendMessage(visitorMessage);
            await visitorPage.waitForTimeout(1000);

            // Minimize the chat widget
            await chatWidgetPage.minimizeWidget();
        });

        await allure.step('Step 2: Operator sends message while visitor chat is minimized', async () => {
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();
            await conversationPage.sendMessage(operatorReply);
            await conversationPage.verifyMessageSent(operatorReply);
        });

        await allure.step('Step 3: Visitor maximizes chat and sees message', async () => {
            await visitorPage.waitForTimeout(2000);
            await chatWidgetPage.maximizeWidget();
            await chatWidgetPage.verifyMessageReceived(operatorReply);
        });
    });
});
