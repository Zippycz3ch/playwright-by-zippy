import { test, expect, Page } from '@playwright/test';
import { LoginPage } from '../../interface/ui/loginPage';
import { DashboardPage } from '../../interface/ui/dashboardPage';
import { ConversationPage } from '../../interface/ui/conversationPage';
import { ChatWidgetPage } from '../../interface/ui/chatWidgetPage';
import * as allure from 'allure-js-commons';

/**
 * Test Suite: Multi-Message Exchange (Complete Conversation Flow)
 * Business Value: CRITICAL - Simulates real-world chat conversations
 * Tests bidirectional communication with multiple message exchanges
 */
test.describe('Chat Communication - Multi-Message Exchange', { tag: ['@chat', '@high-priority', '@business-critical', '@e2e'] }, () => {
    let operatorPage: Page;
    let visitorPage: Page;
    let loginPage: LoginPage;
    let dashboardPage: DashboardPage;
    let conversationPage: ConversationPage;
    let chatWidgetPage: ChatWidgetPage;

    test.beforeEach(async ({ browser }) => {
        // Create two separate browser contexts for operator and visitor
        const operatorContext = await browser.newContext();
        const visitorContext = await browser.newContext();

        operatorPage = await operatorContext.newPage();
        visitorPage = await visitorContext.newPage();

        // Initialize page objects
        loginPage = new LoginPage(operatorPage);
        dashboardPage = new DashboardPage(operatorPage);
        conversationPage = new ConversationPage(operatorPage);
        chatWidgetPage = new ChatWidgetPage(visitorPage);

        // Operator: Login to Smartsupp Dashboard
        await allure.step('Operator: Login to Dashboard', async () => {
            await loginPage.navigate();
            await loginPage.login(process.env.SMARTSUPP_USERNAME!, process.env.SMARTSUPP_PASSWORD!);
            await dashboardPage.verifyDashboardPageLoaded();
            await conversationPage.navigateToInbox();
            await conversationPage.verifyInboxLoaded();
        });

        // Visitor: Open chat widget
        await allure.step('Visitor: Open chat widget', async () => {
            await chatWidgetPage.navigateToPageWithChat(process.env.CHAT_WIDGET_URL || 'https://www.smartsupp.com');
            await chatWidgetPage.openChatWidget();
            await chatWidgetPage.verifyChatWidgetVisible();
        });
    });

    test.afterEach(async () => {
        await operatorPage.close();
        await visitorPage.close();
    });

    test('Complete conversation flow - multiple exchanges @SMOKE @E2E', async () => {
        const timestamp = Date.now();
        const conversation = {
            visitor1: `Hello, I need help with my order #${timestamp}`,
            operator1: `Hi! I'd be happy to help you with order #${timestamp}. What seems to be the issue?`,
            visitor2: 'The tracking number is not working',
            operator2: 'Let me check that for you. One moment please.',
            visitor3: 'Thank you!',
            operator3: 'Your order is currently in transit. The tracking will update within 24 hours.'
        };

        await allure.step('Exchange 1: Visitor initiates conversation', async () => {
            // Visitor sends first message
            await chatWidgetPage.sendMessage(conversation.visitor1);
            await chatWidgetPage.verifyMessageSent(conversation.visitor1);

            // Operator receives and responds
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();
            await conversationPage.verifyMessageReceived(conversation.visitor1, true);
            await conversationPage.sendMessage(conversation.operator1);
            await conversationPage.verifyMessageSent(conversation.operator1);

            // Visitor receives operator response
            await chatWidgetPage.verifyMessageReceived(conversation.operator1);
        });

        await allure.step('Exchange 2: Visitor provides details', async () => {
            // Visitor sends second message
            await chatWidgetPage.sendMessage(conversation.visitor2);
            await chatWidgetPage.verifyMessageSent(conversation.visitor2);

            // Operator sees new message and responds
            await operatorPage.waitForTimeout(1000);
            await conversationPage.verifyMessageReceived(conversation.visitor2, true);
            await conversationPage.sendMessage(conversation.operator2);
            await conversationPage.verifyMessageSent(conversation.operator2);

            // Visitor receives response
            await chatWidgetPage.verifyMessageReceived(conversation.operator2);
        });

        await allure.step('Exchange 3: Conversation conclusion', async () => {
            // Visitor acknowledges
            await chatWidgetPage.sendMessage(conversation.visitor3);
            await chatWidgetPage.verifyMessageSent(conversation.visitor3);

            // Operator provides final response
            await operatorPage.waitForTimeout(1000);
            await conversationPage.verifyMessageReceived(conversation.visitor3, true);
            await conversationPage.sendMessage(conversation.operator3);
            await conversationPage.verifyMessageSent(conversation.operator3);

            // Visitor receives final message
            await chatWidgetPage.verifyMessageReceived(conversation.operator3);
        });

        await allure.step('Verify complete conversation history', async () => {
            // Verify all messages in correct order on operator side
            const expectedOperatorMessages = [
                conversation.visitor1,
                conversation.operator1,
                conversation.visitor2,
                conversation.operator2,
                conversation.visitor3,
                conversation.operator3
            ];
            await conversationPage.verifyMessageOrder(expectedOperatorMessages);

            // Verify all messages visible on visitor side
            const expectedVisitorMessages = [
                conversation.visitor1,
                conversation.operator1,
                conversation.visitor2,
                conversation.operator2,
                conversation.visitor3,
                conversation.operator3
            ];
            await chatWidgetPage.verifyMessageOrder(expectedVisitorMessages);
        });
    });

    test('Rapid back-and-forth messaging', async () => {
        const messages = [
            { sender: 'visitor', text: `Quick question - ${Date.now()}` },
            { sender: 'operator', text: 'Yes, go ahead' },
            { sender: 'visitor', text: 'What are your hours?' },
            { sender: 'operator', text: '9 AM to 5 PM' },
            { sender: 'visitor', text: 'Every day?' },
            { sender: 'operator', text: 'Monday to Friday' },
            { sender: 'visitor', text: 'Perfect, thanks!' }
        ];

        await allure.step('Setup conversation', async () => {
            // Visitor starts
            await chatWidgetPage.sendMessage(messages[0].text);

            // Operator opens conversation
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();
            await conversationPage.verifyMessageReceived(messages[0].text, true);
        });

        await allure.step('Rapid message exchange', async () => {
            for (let i = 1; i < messages.length; i++) {
                const msg = messages[i];

                if (msg.sender === 'visitor') {
                    await chatWidgetPage.sendMessage(msg.text);
                    await visitorPage.waitForTimeout(300);
                    await conversationPage.verifyMessageReceived(msg.text, true);
                } else {
                    await conversationPage.sendMessage(msg.text);
                    await operatorPage.waitForTimeout(300);
                    await chatWidgetPage.verifyMessageReceived(msg.text);
                }
            }
        });

        await allure.step('Verify no messages lost in rapid exchange', async () => {
            const allMessageTexts = messages.map(m => m.text);

            // Check operator side
            const operatorMessages = await conversationPage.getAllMessageTexts();
            for (const msgText of allMessageTexts) {
                const found = operatorMessages.some(m => m.includes(msgText.substring(0, 20)));
                expect(found).toBeTruthy();
            }

            // Check visitor side
            const visitorMessages = await chatWidgetPage.getAllMessageTexts();
            for (const msgText of allMessageTexts) {
                const found = visitorMessages.some(m => m.includes(msgText.substring(0, 20)));
                expect(found).toBeTruthy();
            }
        });
    });

    test('Long conversation with message history persistence', async () => {
        const longConversation = Array.from({ length: 10 }, (_, i) => ({
            sender: i % 2 === 0 ? 'visitor' : 'operator',
            text: `Message ${i + 1} - ${Date.now() + i}`
        }));

        await allure.step('Build long conversation', async () => {
            // Start with visitor
            await chatWidgetPage.sendMessage(longConversation[0].text);

            // Open on operator side
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();

            // Exchange messages
            for (let i = 1; i < longConversation.length; i++) {
                const msg = longConversation[i];

                if (msg.sender === 'visitor') {
                    await chatWidgetPage.sendMessage(msg.text);
                    await visitorPage.waitForTimeout(500);
                } else {
                    await conversationPage.sendMessage(msg.text);
                    await operatorPage.waitForTimeout(500);
                }
            }
        });

        await allure.step('Verify conversation persists after operator page reload', async () => {
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();

            // Wait for history to load
            await operatorPage.waitForTimeout(2000);

            // Verify messages still there
            const messages = await conversationPage.getAllMessages().all();
            expect(messages.length).toBeGreaterThanOrEqual(longConversation.length);
        });

        await allure.step('Verify conversation persists after visitor page reload', async () => {
            await visitorPage.reload();
            await visitorPage.waitForLoadState('networkidle');
            await chatWidgetPage.openChatWidget();

            // Wait for history to load
            await visitorPage.waitForTimeout(2000);

            // Verify messages still there
            const messages = await chatWidgetPage.getAllMessages().all();
            expect(messages.length).toBeGreaterThanOrEqual(longConversation.length);
        });
    });

    test('Conversation with mixed message types (text, emojis, special chars)', async () => {
        const mixedMessages = [
            { sender: 'visitor', text: 'Hello 👋' },
            { sender: 'operator', text: 'Hi there! 😊 How can I help?' },
            { sender: 'visitor', text: 'I need info about pricing <standard>' },
            { sender: 'operator', text: 'Sure! Visit https://example.com/pricing' },
            {
                sender: 'visitor', text: `Multi-line message:
Line 1
Line 2` },
            { sender: 'operator', text: 'Special chars: &, <, >, ", \'' }
        ];

        await allure.step('Setup and exchange mixed content messages', async () => {
            // Start conversation
            await chatWidgetPage.sendMessage(mixedMessages[0].text);

            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();

            // Exchange all messages
            for (let i = 1; i < mixedMessages.length; i++) {
                const msg = mixedMessages[i];

                if (msg.sender === 'visitor') {
                    await chatWidgetPage.sendMessage(msg.text);
                    await visitorPage.waitForTimeout(500);
                } else {
                    await conversationPage.sendMessage(msg.text);
                    await operatorPage.waitForTimeout(500);
                }
            }
        });

        await allure.step('Verify all content types preserved', async () => {
            // Verify emojis on both sides
            await expect(conversationPage.getVisitorMessage('👋')).toBeVisible();
            await expect(conversationPage.getOperatorMessage('😊')).toBeVisible();
            await expect(chatWidgetPage.getOperatorMessage('😊')).toBeVisible();

            // Verify URLs
            await conversationPage.verifyMessageReceived('https://example.com/pricing', false);
            await chatWidgetPage.verifyMessageReceived('https://example.com/pricing');

            // Verify special characters escaped properly
            await conversationPage.verifyMessageReceived('Special chars', false);
        });
    });
});
