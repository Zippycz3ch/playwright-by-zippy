import { test, expect, Page } from '@playwright/test';
import { LoginPage } from '../../interface/ui/loginPage';
import { DashboardPage } from '../../interface/ui/dashboardPage';
import { ConversationPage } from '../../interface/ui/conversationPage';
import { ChatWidgetPage } from '../../interface/ui/chatWidgetPage';
import * as allure from 'allure-js-commons';

/**
 * Test Suite: Visitor to Operator Message Communication
 * Business Value: HIGH - Core chat functionality
 * Tests basic message sending from visitor to operator
 */
test.describe('Chat Communication - Visitor to Operator', { tag: ['@chat', '@high-priority', '@business-critical'] }, () => {
    let operatorPage: Page;
    let visitorPage: Page;
    let loginPage: LoginPage;
    let dashboardPage: DashboardPage;
    let conversationPage: ConversationPage;
    let chatWidgetPage: ChatWidgetPage;

    test.beforeEach(async ({ browser }) => {
        // Create two separate browser contexts for operator and visitor
        const operatorContext = await browser.newContext();
        const visitorContext = await browser.newContext();

        operatorPage = await operatorContext.newPage();
        visitorPage = await visitorContext.newPage();

        // Initialize page objects
        loginPage = new LoginPage(operatorPage);
        dashboardPage = new DashboardPage(operatorPage);
        conversationPage = new ConversationPage(operatorPage);
        chatWidgetPage = new ChatWidgetPage(visitorPage);

        // Operator: Login to Smartsupp Dashboard
        await allure.step('Operator: Login to Dashboard', async () => {
            await loginPage.navigate();
            await loginPage.login(process.env.SMARTSUPP_USERNAME!, process.env.SMARTSUPP_PASSWORD!);
            await dashboardPage.verifyDashboardPageLoaded();
            await conversationPage.navigateToInbox();
            await conversationPage.verifyInboxLoaded();
        });
    });

    test.afterEach(async () => {
        await operatorPage.close();
        await visitorPage.close();
    });

    test('Visitor sends message and operator receives it @SMOKE', async () => {
        const testMessage = `Test message from visitor - ${Date.now()}`;

        await allure.step('Step 1: Visitor opens chat and sends message', async () => {
            // Navigate to a page with Smartsupp chat widget
            // Note: Replace with actual URL that has the chat widget
            await chatWidgetPage.navigateToPageWithChat(process.env.CHAT_WIDGET_URL || 'https://www.smartsupp.com');

            await chatWidgetPage.openChatWidget();
            await chatWidgetPage.verifyChatWidgetVisible();

            await chatWidgetPage.sendMessage(testMessage);
            await chatWidgetPage.verifyMessageSent(testMessage);
        });

        await allure.step('Step 2: Operator receives and verifies message', async () => {
            // Refresh inbox to see new conversation
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');

            // Open the latest conversation
            await conversationPage.openFirstConversation();

            // Verify the message is received
            await conversationPage.verifyMessageReceived(testMessage, true);
        });

        await allure.step('Step 3: Verify message metadata', async () => {
            // Verify timestamp is shown (basic check)
            const messages = await conversationPage.getAllMessages().all();
            expect(messages.length).toBeGreaterThan(0);

            // Verify visitor message is properly identified
            const visitorMsg = conversationPage.getVisitorMessage(testMessage);
            await expect(visitorMsg).toBeVisible();
        });
    });

    test('Visitor sends multiple messages and all appear in operator dashboard', async () => {
        const messages = [
            `First message - ${Date.now()}`,
            `Second message - ${Date.now() + 1}`,
            `Third message - ${Date.now() + 2}`
        ];

        await allure.step('Step 1: Visitor sends three consecutive messages', async () => {
            await chatWidgetPage.navigateToPageWithChat(process.env.CHAT_WIDGET_URL || 'https://www.smartsupp.com');
            await chatWidgetPage.openChatWidget();

            for (const msg of messages) {
                await chatWidgetPage.sendMessage(msg);
                await visitorPage.waitForTimeout(500);
            }

            // Verify all messages sent
            for (const msg of messages) {
                await chatWidgetPage.verifyMessageSent(msg);
            }
        });

        await allure.step('Step 2: Operator sees all messages in correct order', async () => {
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();

            // Verify all messages received
            for (const msg of messages) {
                await conversationPage.verifyMessageReceived(msg, true);
            }

            // Verify message order
            await conversationPage.verifyMessageOrder(messages);
        });
    });

    test('Visitor message delivery within acceptable time frame @PERFORMANCE', async () => {
        const testMessage = `Performance test message - ${Date.now()}`;
        let sendTime: number;
        let receiveTime: number;

        await allure.step('Step 1: Visitor sends message and record timestamp', async () => {
            await chatWidgetPage.navigateToPageWithChat(process.env.CHAT_WIDGET_URL || 'https://www.smartsupp.com');
            await chatWidgetPage.openChatWidget();

            sendTime = Date.now();
            await chatWidgetPage.sendMessage(testMessage);
            await chatWidgetPage.verifyMessageSent(testMessage);
        });

        await allure.step('Step 2: Operator receives message and verify delivery time', async () => {
            // Reload and open conversation
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();

            // Verify message appears
            await conversationPage.verifyMessageReceived(testMessage, true);
            receiveTime = Date.now();

            // Calculate delivery time
            const deliveryTime = receiveTime - sendTime;
            console.log(`Message delivery time: ${deliveryTime}ms`);

            // Verify delivery within 10 seconds (including page reload)
            expect(deliveryTime).toBeLessThan(10000);
        });
    });

    test('Visitor sends message with special characters and emojis', async () => {
        const specialMessage = `Test 🎉 Special chars: <>&"' | Emoji: 😀👍 - ${Date.now()}`;

        await allure.step('Step 1: Visitor sends message with special content', async () => {
            await chatWidgetPage.navigateToPageWithChat(process.env.CHAT_WIDGET_URL || 'https://www.smartsupp.com');
            await chatWidgetPage.openChatWidget();

            await chatWidgetPage.sendMessage(specialMessage);
            await chatWidgetPage.verifyMessageSent(specialMessage);
        });

        await allure.step('Step 2: Operator receives message with special characters intact', async () => {
            await operatorPage.reload();
            await operatorPage.waitForLoadState('networkidle');
            await conversationPage.openFirstConversation();

            // Verify special characters and emojis are preserved
            const visitorMsg = conversationPage.getVisitorMessage('🎉');
            await expect(visitorMsg).toBeVisible();

            // Verify HTML characters are escaped
            await conversationPage.verifyMessageReceived('Special chars', true);
        });
    });
});
